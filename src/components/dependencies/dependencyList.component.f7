<template>
  <div class="list list-strong list-outline-ios list-strong-ios list-dividers-ios media-list chevron-center">
    <${Lister} packages=${packages} maxItem=${props.max} />
  </div>
</template>

<script>
  import Lister from "./lister.component.f7";
  export default async (props) => {
    const packages = props.dependencies.packages.filter((p) =>
      p.type.includes("devDependency"),
    );
    return $render;
  };
</script>