              <div class="card-s">$:south_indicator</div>
            </div>

            <div class="needle-wrapper" id="needleWrapper">
              <div class="needle"></div>
            </div>

            <div class="center-dot"></div>
          </div>

          <div class="info-panel">
            <div class="distance-badge" id="distBadge">$:distance: --</div>
            <div class="main-degree" id="azimuthDisplay">--°</div>
            <div style="font-size: 12px; opacity: 0.6">$:target_direction</div>
