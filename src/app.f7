      </div>
      <div class="navbar navbar-transparent dark">
        <div class="navbar-bg"></div>
        <div class="navbar-inner sliding">
          <div class="title" style="width: 100%">$:title</div>
          <div class="right">
            <a href="#" class="link color-white sheet-open" data-sheet="#settings-sheet" aria-label="$:app_settings"
              title="$:app_settings">
              <i class="icon material-symbols rounded filled md-only">settings</i>
              <!-- Prevents lazy loading for material symbols (lazy loading causes dependencies page direct dependency icon has FOUT (flash of unstyled text)) -->
              <i class="icon f7-icons ios-only">gear</i>
            </a>
          </div>
        </div>
      </div>

      <div class="page-content" style="padding-top: 0; overflow: hidden">
        <div id="cameraView">
          <video id="camVideo" autoplay webkit-playsinline playsinline muted
            poster="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="></video>
          <div class="ar-overlay">
            <div class="ar-top-info">
              <h2 class="uppercase">$:mausoleum</h2>
              <div class="ar-dist" id="arDistLabel">$:calculating</div>
            </div>

            <div class="ar-tape-wrapper">
              <div class="dir-arrow dir-left" id="arrowLeft">
                <i class="icon material-icons">arrow_back</i>
              </div>

              <div class="tape-track">
                <div class="tape-marker" id="tapeMarker" style="display: none">
                  <div class="tm-label uppercase">$:target</div>
                  <div class="tm-arrow"></div>
                  <div class="tm-line"></div>
                </div>
              </div>

              <div class="dir-arrow dir-right" id="arrowRight">
                <i class="icon material-icons">arrow_forward</i>
              </div>
            </div>

            <div style="
                text-align: center;
