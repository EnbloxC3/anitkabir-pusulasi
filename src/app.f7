        <div class="control-grid fulldeactive">
          <div class="fab fab-mini fab-left-top" id="openCompass" aria-label="$:open_compass" title="$:open_compass">
            <a href="#" class="link">
              <i class="icon material-icons md-only">keyboard_arrow_down</i>
              <i class="icon f7-icons ios-only">chevron_down</i>
            </a>
          </div>
          <button class="button button-fill button-large button-round" id="permBtn">
            <i class="icon material-icons md-only">explore</i>
            <i class="icon f7-icons ios-only">compass_fill</i>
            $:calibrate
          </button>
          <button class="button button-large button-round button-outline" id="refBtn">
            <i class="icon material-icons md-only">refresh</i>
            <i class="icon f7-icons ios-only">arrow_2_circlepath</i>
            $:refresh
          </button>

          <button class="button button-fill siren-btn ripple" id="sirenBtn">
            <span class="siren-icon-start"><i class="icon material-icons md-only">volume_up</i>
              <i class="icon f7-icons ios-only">speaker_3</i></span>
            <span class="siren-icon-stop" style="display: none"><i class="icon material-icons md-only">stop</i><i
                class="icon f7-icons ios-only">stop</i></span>
            <span class="siren-text uppercase">$:siren</span>
          </button>
        </div>

        <div class="block block-strong inset display-flex justify-content-center align-items-center" style="
            background: rgba(255, 255, 255, 0.05);
            color: #aaa;
            font-size: 12px;
          ">
          <i class="icon material-icons md-only" style="font-size: 16px; margin-right: 6px">info</i>
          <i class="icon f7-icons ios-only" style="font-size: 16px; margin-right: 6px">info_circle_fill</i>
          <span>$:mode_switch_info</span>
        </div>
      </div>
    </div>
    <div class="popover popover-menu" id="context-popover">
      <div class="popover-inner">
        <div class="list">
          <ul></ul>
        </div>
      </div>
    </div>
  </div>
</template>
<script>
  import strings, { _dom_utils } from "@/js/string.js";
  const { pages } = strings;
  export default (_, { $, $f7, $el, $once }) => {
    $once("pageInit", (_, page) => {
      //if (page.el !== $el.value[0]) return;
      const context = pages[page.name];
      _dom_utils.parseElement($el.value[0], context);

      //mainpage specific
      document.documentElement.lang = strings.internal.lang;
      document.documentElement.dir = strings.internal.dir;
      const documentStyles = getComputedStyle(document.documentElement);
      /*dynamic manifest*/
      setManifest({
        name: strings.app.name,
        short_name: strings.app.name.split(" ")[0],
        description: strings.app.description,
        lang: document.documentElement.lang,
        dir: document.documentElement.dir,
        theme_color: documentStyles.getPropertyValue($f7.device.desktop ? "--f7-bars-bg-color" : "--f7-theme-color").trim(),
        background_color: documentStyles.getPropertyValue("--f7-page-bg-color").trim(),
        screenshots: [
          { label: `${strings.app.name} ${strings.common.light}` },
          { label: `${strings.app.name} ${strings.common.dark}` },
          { label: `${strings.app.name} ${strings.common.light}` },
          { label: `${strings.app.name} ${strings.common.dark}` },
        ]
      });
      $(`meta[name="theme-color"]`).attr("content", documentStyles.getPropertyValue($f7.device.desktop ? "--f7-bars-bg-color" : "--f7-theme-color").trim())

      //page specific
      if (sessionStorage.getItem("splitMenu") === "1")
        $el.value
          .find("div.compass-container, div.control-grid")
          .toggleClass("fulldeactive");
    });
    return $render;
  };
</script>