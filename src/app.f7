          <div class="fab fab-mini fab-right-bottom" id="openControls" aria-label="$:open_controls"
            title="$:open_controls">
            <a href="#" class="link">
              <i class="icon material-icons md-only">keyboard_arrow_up</i>
              <i class="icon f7-icons ios-only">chevron_up</i>
            </a>
          </div>
