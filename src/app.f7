                          <a href="#" class="button button-small button-round button-outline button-active"
                            data-value="auto">$:theme_mode_system</a>
                          <a href="#" class="button button-small button-round button-outline"
                            data-value="dark">$:theme_mode_dark</a>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>

                <li>
                  <div class="item-content">
                    <div class="item-inner">
                      <div class="item-title">$:silent_mode ($:siren)</div>
                      <div class="item-after">
                        <label class="toggle toggle-init">
                          <input type="checkbox" id="toggle-mute" />
                          <span class="toggle-icon"></span>
                        </label>
                      </div>
                    </div>
                  </div>
                </li>
              </ul>
            </div>

            <div class="list links-list">
              <ul>
                <li>
                  <a class="sheet-close" href="/bugs/" aria-label="$:bugs">$:bugs</a>
                </li>
                <li>
                  <a class="sheet-close" href="/about/" aria-label="$:about">$:about</a>
                </li>
              </ul>
